table resumo_ano
	lineageTag: b2ff35e5-1c3d-4786-be38-d3c7f25592c9

	measure 'Crescimento Médio %' = AVERAGE(populacao_municipio[crescimento_pct])
		lineageTag: e59e6ee9-6342-47bf-8717-2bed3184d2e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação Absoluta Total' = SUM(populacao_municipio[variacao_absoluta])
		formatString: 0.000
		lineageTag: 777eeafb-eb7d-4d7c-b48b-b27f74c138ff

	column ano
		dataType: dateTime
		formatString: Long Date
		lineageTag: ac981697-5b83-4691-9f2e-66d5d8d34bb3
