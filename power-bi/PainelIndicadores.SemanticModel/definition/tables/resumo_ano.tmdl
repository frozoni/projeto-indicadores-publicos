			defaultHierarchy: LocalDateTable_9b4d4d5e-e927-48ab-bc2c-3acdd1cde4bf.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column populacao_total
		dataType: int64
		formatString: 0.000
		lineageTag: 903397b2-35f5-499c-9694-b7f42e49a807
