		formatString: 0
		lineageTag: 2261eed7-2855-4e9b-bd79-8b1e598346b1
		summarizeBy: none
		sourceColumn: crescimento_medio_pct

		annotation SummarizationSetBy = User

	column variacao_absoluta_total
