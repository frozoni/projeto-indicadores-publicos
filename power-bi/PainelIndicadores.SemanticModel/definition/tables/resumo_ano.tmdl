		annotation SummarizationSetBy = User

	column 'Cor Regiao' =
			
			SWITCH(
			    SELECTEDVALUE(populacao_municipio[regiao]),
			    "Norte", "#eb6834",
			    "Nordeste", "#e87ba4",
			    "Centro-Oeste", "#eda100",
			    "Sudeste", "#2a78d6",
			    "Sul", "#1baf7a",
			    "#898781"
			)
		lineageTag: 8b361882-1fcd-45ed-8086-8b0a03a5c7fc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

